# ─────────────────────────────────────────────────────────────────────────────
# 24Boda Monorepo .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code — uncomment if you don't want to share launch configs
#.vscode/

# ── Flutter / Dart / Pub ──────────────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
**/android/app/debug
**/android/app/profile
**/android/app/release

# ── Environment / Secret files ────────────────────────────────────────────────
# Never commit secret keys or environment files
.env
.env.*
*.env
!.env.example

# ── Firebase ──────────────────────────────────────────────────────────────────
# firebase_options.dart is SAFE to commit — it contains no secrets.
# Firebase security is enforced by Firestore Security Rules, not by
# hiding the config. Do NOT add firebase_options.dart here.
#
# These are local Firebase emulator files — not needed in Git
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ── Google services files ─────────────────────────────────────────────────────
# These are auto-generated by flutterfire configure — safe to commit
# but listed here for reference. Do NOT uncomment these lines.
# google-services.json
# GoogleService-Info.plist

# ── Keystore files ────────────────────────────────────────────────────────────
# Android signing keys — never commit these
*.jks
*.keystore
key.properties

# ── macOS ─────────────────────────────────────────────────────────────────────
**/macos/Flutter/GeneratedPluginRegistrant.swift

# ── Windows ───────────────────────────────────────────────────────────────────
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# dart-define files — contain API keys, never commit
.dart_defines
